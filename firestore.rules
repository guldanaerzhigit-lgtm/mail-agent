rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isSelf(userId);
    }

    // Chat metadata is optional now. Messages do NOT depend on this document.
    match /chats/{chatId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow delete: if signedIn();
    }

    // Messages are top-level documents. Each message carries its two participants.
    // This avoids permission checks through a parent chat document.
    match /messages/{messageId} {
      allow read: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}