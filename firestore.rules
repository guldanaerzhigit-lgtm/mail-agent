rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(chatId) {
      return signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSelf(userId);
    }

    match /chats/{chatId} {
      // Create: the authenticated user must be one of the two participants.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      // Read/update: the authenticated user must remain a participant.
      allow read: if isParticipant(chatId);
      allow update: if isParticipant(chatId)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isParticipant(chatId);

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in resource.data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}