rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(data) { return signedIn() && request.auth.uid in data.participants; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isUser(userId);
    }

    match /messages/{messageId} {
      allow read: if participant(resource.data);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;

      // Only the receiver may add delivery/read timestamps.
      // Message text, sender, receiver and participants cannot be changed.
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.text == resource.data.text
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.createdAtMs == resource.data.createdAtMs;

      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == resource.data.toId
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /{document=**} { allow read, write: if false; }
  }
}