rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(data) { return signedIn() && request.auth.uid in data.participants; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if me(uid) && request.resource.data.uid == request.auth.uid;
      allow delete: if me(uid);
    }
    match /messages/{id} {
      allow read: if participant(resource.data);
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size()==2 && request.auth.uid in request.resource.data.participants && request.resource.data.senderId==request.auth.uid && request.resource.data.receiverId in request.resource.data.participants && request.resource.data.chatId is string && request.resource.data.type in ['text','file'] && (request.resource.data.type=='file' || (request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=5000));
      allow update: if signedIn() && request.auth.uid==resource.data.receiverId && request.resource.data.senderId==resource.data.senderId && request.resource.data.receiverId==resource.data.receiverId && request.resource.data.participants==resource.data.participants && request.resource.data.chatId==resource.data.chatId;
      allow delete: if false;
    }
    match /messageReceipts/{id} {
      allow read: if participant(resource.data);
      allow create, update: if signedIn() && request.auth.uid==request.resource.data.readerId && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size()==2;
      allow delete: if false;
    }
    match /friendRequests/{id} {
      allow read: if signedIn() && (request.auth.uid==resource.data.fromId || request.auth.uid==resource.data.toId);
      allow create: if signedIn() && request.resource.data.fromId==request.auth.uid && request.resource.data.toId is string && request.resource.data.toId!=request.auth.uid && request.resource.data.status=='pending';
      allow update: if signedIn() && request.auth.uid==resource.data.toId && request.resource.data.fromId==resource.data.fromId && request.resource.data.toId==resource.data.toId && request.resource.data.status in ['accepted','declined'];
      allow delete: if false;
    }
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size()==2 && request.auth.uid in request.resource.data.participants;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /{document=**} { allow read, write: if false; }
  }
}