rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isParticipant() { return signedIn() && request.auth.uid in resource.data.participants; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isUser(userId);
    }

    match /messages/{messageId} {
      allow read: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == resource.data.toId
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // Delivery/read receipts. Only the receiving user can create/update a receipt.
    match /messageReceipts/{messageId} {
      allow read: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.readerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.readerId == request.auth.uid
        && request.resource.data.readerId == request.auth.uid
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    // Temporary typing state. Only chat participants can read/write their own state.
    match /typing/{typingId} {
      allow read: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}